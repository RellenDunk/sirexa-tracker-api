// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  binaryTargets = ["native","linux-musl-openssl-3.0.x"]
  
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RegistrationType {
  MAIN
  SECONDARY
}

///only NEW registrations are counted in user rankings, this allows for promotions and downgrades not inflating
enum RegistrationOrigin {
  NEW
  UPGRADE
  DOWNGRADE
}

///This is necessary so that we can know they didn't deregister, and still use it in user registration counts - also allows the information to be used in visualizations of sessions
enum RegistrationSessionStatus {
  ACTIVE
  DEREGISTERED
  PROMOTED
  DEMOTED
}

/// Represents the different tiers of users in Sirexa
enum UserTiers {
  BASIC
  PREMIUM
  TRUSTED
  ELITE
  PRIORITIZED
  ENFORCER
  MIRU
}

enum UserStatus {
  BANNED
  ACTIVE
}

/// Represents the current server that Sirexa is in.
model CurrentServer {
  id                    Int  @id @default(1)
  currentServerId       String
  currentServerName     String
}

model Server {
  /// This is a UUID that is generated by the database
  id       String    @id @default(uuid())
  name     String    @unique
  users    User[]
  sessions Session[]
}

/// Represent a registered user of Sirexa
model User {
  /// This is a UUID that is generated by the database
  id                 String         @id @default(uuid())
  /// character's real name (might be unknown)
  characterName      String        
  /// password create when user is high enough level
  password           String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  lastRegistrationAt DateTime?
  Registration       Registration[]
  tier               UserTiers      @default(BASIC)
  tierUpdatedAt      DateTime?

  server   Server @relation(fields: [serverId], references: [id])
  serverId String

  banAppealMeeting BanAppealMeeting[]

  @@unique([characterName, serverId])
  Ban Ban?
}

/// Represent a registration session for Sirexa
model Session {
  id           String    @id @default(uuid())
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  sessionNotes String?
  currentNumUsers Int       @default(0)

  // relations
  server   Server @relation(fields: [serverId], references: [id])
  serverId String

  registrations Registration[] @relation("SessionRegistrations")

  currrentSession CurrentSession[]
}

model CurrentSession {
  session Session @relation(fields: [sessionId], references: [id])
  id Int @id @default(1)
  sessionId String
}

/// represents an instance of a user registering with sirexa
model Registration {
  id        String             @id @default(uuid())
  userName  String
  startedAt DateTime           @default(now())
  endedAt   DateTime?
  updatedAt DateTime           @updatedAt
  type      RegistrationType
  origin    RegistrationOrigin
  sessionPosition Int @default(0)
  sessionStatus RegistrationSessionStatus @default(ACTIVE)


  //relations
  user   User   @relation(fields: [userId], references: [id])
  userId String

  session   Session @relation("SessionRegistrations", fields: [sessionId], references: [id])
  sessionId String
}

model Ban {
  id      String @id @default(uuid())
  reason  String @default("")
  canAppeal Boolean @default(true)

  //relations
  user    User @relation(fields:[userId], references:[id]) 
  userId  String @unique 
}
model BanAppealMeeting {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  meetingDate DateTime
  notes       String?

  // relations
  user   User   @relation(fields: [userId], references: [id])
  userId String
}
