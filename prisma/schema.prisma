// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  binaryTargets = ["native","linux-musl-openssl-3.0.x"]
  
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RegistrationType {
  MAIN
  SECONDARY
}

enum RegistrationOrigin {
  NEW
  Upgrade
  Downgrade
}

/// Represents the different tiers of users in Sirexa
enum UserTiers {
  BASIC
  PREMIUM
  ELITE
  PRIORITIZED
  MIRU
}

enum UserStatus {
  BANNED
  ACTIVE
}

/// Represents the current server that Sirexa is in.
model CurrentServer {
  currentServer Server @relation(fields: [currentServerId], references: [id])
  currentServerId     String    @id
}

model Server {
  /// This is a UUID that is generated by the database
  id       String    @id @default(uuid())
  name     String    @unique
  users    User[]
  sessions Session[]

  currentServer CurrentServer[]
}

/// Represent a registered user of Sirexa
model User {
  /// This is a UUID that is generated by the database
  id                 String         @id @default(uuid())
  /// character's real name (might be unknown)
  characterName      String?
  /// password create when user is high enough level
  password           String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  registrationCount  Int            @default(0)
  lastRegistrationAt DateTime?
  Registration       Registration[]
  status             UserStatus     @default(ACTIVE)
  tier               UserTiers      @default(BASIC)
  tierUpdatedAt      DateTime?

  Server   Server @relation(fields: [serverId], references: [id])
  serverId String

  banAppealMeeting banAppealMeeting[]
}

/// Represent a registration session for Sirexa
model Session {
  id           String    @id @default(uuid())
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  sessionNotes String?

  // relations
  Server   Server @relation(fields: [serverId], references: [id])
  serverId String

  registrations Registration[] @relation("SessionRegistrations")

  currrentSession currrentSession[]
}

model currrentSession {
  currentSession Session @relation(fields: [currentSessionId], references: [id])
  currentSessionId String @id
}

/// represents an instance of a user registering with sirexa
model Registration {
  id        String             @id @default(uuid())
  startedAt DateTime           @default(now())
  endedAt   DateTime?
  type      RegistrationType
  origin    RegistrationOrigin

  //relations
  User   User   @relation(fields: [userId], references: [id])
  userId String

  session   Session @relation("SessionRegistrations", fields: [sessionId], references: [id])
  sessionId String
}

model banAppealMeeting {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  meetingDate DateTime
  notes       String?

  // relations
  User   User   @relation(fields: [userId], references: [id])
  userId String
}
